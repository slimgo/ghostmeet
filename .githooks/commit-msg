#!/bin/bash
#
# Заголовок коммита — по-английски. Правило записано в CLAUDE.md, но одного
# правила оказалось мало: четыре релизных коммита подряд вышли по-русски, потому
# что set-version.sh печатал русскую строку, а её копировали не читая.
#
# Проверяется **только первая строка.** Тело обязано принимать кириллицу: в нём
# цитируются строки интерфейса, промпты и сообщения об ошибках, а перевод цитаты
# лишает её смысла.
#
# Ставится один раз на репозиторий:
#   git config core.hooksPath .githooks

SUBJECT="$(head -1 "$1")"

# Автор коммитов — владелец репозитория, и соавторства в них нет. Причина
# видна на странице проекта: GitHub считает соавторов контрибьюторами, и в
# списке из одного человека вторым именем стояла модель. Правило записано в
# CLAUDE.md, а держится здесь — трейлер добавляется по привычке инструмента,
# то есть ровно тем способом, каким правило и обходится.
if grep -qi '^Co-Authored-By:.*claude' "$1"; then
  echo "✗ В сообщении остался трейлер Co-Authored-By с моделью." >&2
  echo "  Автор коммита один — владелец репозитория; уберите строку." >&2
  exit 1
fi

# Слияние своих же веток git пишет сам, и переписывать его заголовок нечем.
case "$SUBJECT" in
  "Merge branch"*|"Merge remote"*|"Revert "*|"fixup!"*|"squash!"*) exit 0 ;;
esac

# Диапазон задаётся явно, а не классом в кавычках: «[\xd0-\xd1]» внутри
# одинарных кавычек — не байты, а буквальные символы, и такой класс ловит
# латиницу заодно с кириллицей. Первая редакция этого хука отвергала оба.
# Код возврата читается как у grep: ноль значит «нашёл кириллицу».
if python3 -c 'import sys; sys.exit(0 if any("\u0400" <= c <= "\u04ff" for c in sys.argv[1]) else 1)' "$SUBJECT"; then
  echo "✗ Заголовок коммита написан по-русски:" >&2
  echo "    $SUBJECT" >&2
  echo >&2
  echo "  Репозиторий публичный, и историю читают те же люди, что и README." >&2
  echo "  Заголовок — по-английски; тело может цитировать русский текст." >&2
  exit 1
fi
