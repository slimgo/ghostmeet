<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>NSMicrophoneUsageDescription</key>
	<string>Нужен доступ к микрофону, чтобы учитывать ваши реплики в контексте (канал You)</string>
	<key>NSAudioCaptureUsageDescription</key>
	<string>Нужен доступ к системному аудио, чтобы распознавать речь собеседников (канал Them)</string>
	<key>NSScreenCaptureUsageDescription</key>
	<string>Нужен для анализа экрана и режима «Реши задачу»</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Нужен для распознавания речи через Apple Speech, если локальный Whisper недоступен</string>
	<key>LSUIElement</key>
	<true/>

	<!-- Sparkle. Все четыре ключа живут здесь, а не в INFOPLIST_KEY_* сборки:
	     Xcode знает не все из них и незнакомые выбрасывает молча — сборка
	     проходит, ключ до бандла не доезжает. Для строк разрешений это уже
	     стоило проекту дня; здесь дороже, потому что без SUPublicEDKey
	     проверять подпись обновления нечем. Стоит проверка в make-dmg.sh. -->

	<!-- Постоянный адрес: GitHub всегда отдаёт по нему ассет последнего
	     релиза, не зная его номера. Он вшит в собранное приложение и потому
	     меняться не может — старые машины узнают о новых версиях только
	     через него. -->
	<key>SUFeedURL</key>
	<string>https://github.com/slimgo/ghostmeet/releases/latest/download/appcast.xml</string>

	<!-- Открытая половина пары EdDSA. Закрытая живёт в Keychain машины
	     разработчика и в репозиторий не попадает никогда: подписанное ею
	     обновление приложение поставит само, не спросив пользователя. -->
	<key>SUPublicEDKey</key>
	<string>uxizVbEJK+sARuwP2diO28mYcEHLw6urC2Gv0T6776c=</string>

	<!-- Приложение обещает, что наружу уходит IP и версия и больше ничего.
	     У Sparkle есть необязательная отправка сведений о системе: модель
	     машины, разрядность, версия ОС и язык уезжают строкой запроса,
	     приклеенной к адресу ленты (SPUUpdater.parameterizedFeedURL). Здесь
	     она выключена, и выключена с трёх сторон, потому что одной мало.

	     Ключи разные, и очевидный из них — не тот. Отправку гейтит
	     SUSendProfileInfo: SPUUpdaterSettings читает его через
	     SUHost.boolForKey, а тот сперва смотрит в UserDefaults и только
	     потом сюда. SUEnableSystemProfiling к отправке отношения не имеет
	     вовсе — по нему ставится галочка в диалоге разрешения
	     (SUUpdatePermissionPrompt), который у нас и не показывается.
	     Объявлены оба: один запрещает по существу, второй — чтобы
	     задокументированный ключ не обещал обратного.

	     Третья сторона — sendsSystemProfile у самого updater'а. Он пишет в
	     UserDefaults и потому перебивает оба ключа отсюда, если в них
	     что-то однажды окажется; выставляется в коде. -->
	<key>SUSendProfileInfo</key>
	<false/>
	<key>SUEnableSystemProfiling</key>
	<false/>

	<!-- Расписания у обновления нет: приложение открывают перед звонком и
	     закрывают после, и таймер потратил бы чужую сеть на ответ, который
	     не мог измениться. Проверка идёт один раз при запуске, как и раньше
	     (ADR-0010), и её по-прежнему снимает один переключатель. -->
	<key>SUEnableAutomaticChecks</key>
	<false/>
</dict>
</plist>
