    "«%@» завершился с кодом %@.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” exited with code %@."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "new",
            "value": "«%1$@» завершился с кодом %2$@."
          }
        }
      }
    },
    "«%@» сейчас не выдаёт звук. Захват включится сам, как только приложение вернётся.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” is not making any sound right now. Capture starts by itself as soon as the application is back."
          }
        }
      }
    },
    "·": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "·"
          }
        }
      }
