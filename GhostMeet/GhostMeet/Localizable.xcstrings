    "%@ Проверьте последние поля — они могли не дописаться.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Check the last fields — they may be incomplete."
          }
        }
      }
    },
    "%@ не подойдёт: GhostMeet читает резюме в форматах .txt, .md и .pdf. Сохраните резюме в одном из них — или заполните поля профиля руками.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ will not do: GhostMeet reads résumés in .txt, .md and .pdf. Save the résumé in one of those — or fill the profile fields in by hand."
          }
        }
      }
    },
    "%@ — %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ — %@"
