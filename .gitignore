# Служебные каталоги инструментов
.serena/

# Swift Package Manager
.build/
.swiftpm/

# Секреты: API-ключи провайдеров храним в Keychain, не в репозитории
*.xcconfig.local
Secrets.plist

# Закрытый ключ обновлений. Живёт в Keychain — там его оставляет generate_keys,
# и оттуда его берут sign_update и generate_appcast, — так что в дереве ему
# взяться неоткуда. Шаблоны стоят на случай, когда его всё-таки выгрузили
# (generate_keys -x) и забыли убрать: цена такой забывчивости выше, чем у
# утёкшего сертификата, потому что подписанное этим ключом обновление
# приложение поставит само и пользователя не спросит. Тот же запрет продублирован
# проверкой в release.sh — .gitignore молчит, когда файл уже добавлен с -f.
*.pem
*.p12
*private*key*
*_private_key*
sparkle_private_key*

# Сборки для передачи: артефакты, не исходники
dist/

# IDE JetBrains: конфигурация машины, а не проекта
.idea/

# Результаты прогонов: артефакт диагностики, не исходник
*.xcresult/

# Клон SPM-пакетов для воспроизведения CI локально
.spm/

# Байткод скриптов разбора: артефакт запуска, не исходник
__pycache__/

# Сохранённые диалоги с настоящих звонков: материал для подбора порогов
# протечки. Это живая речь живых людей — в публичный репозиторий она не едет
# ни при каких обстоятельствах. Пояснение, что сюда класть, остаётся видимым.
.scratch/leak-calls/*
!.scratch/leak-calls/README.md
