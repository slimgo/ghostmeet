# Сборки для передачи: артефакты, не исходники
dist/

# IDE JetBrains: конфигурация машины, а не проекта
.idea/

# Результаты прогонов: артефакт диагностики, не исходник
*.xcresult/

# Клон SPM-пакетов для воспроизведения CI локально
.spm/

# Байткод скриптов разбора: артефакт запуска, не исходник
__pycache__/

# Сохранённые диалоги с настоящих звонков: материал для подбора порогов
# протечки. Это живая речь живых людей — в публичный репозиторий она не едет
# ни при каких обстоятельствах. Пояснение, что сюда класть, остаётся видимым.
.scratch/leak-calls/*
!.scratch/leak-calls/README.md
